# Copy to .env (git-ignored) and fill in — or export the same variables.
# Retrieval, embedding, analytics and evaluation work without any of these;
# only the LLM answer step needs an OpenAI-compatible endpoint.

# Explicit GuardLens override (highest priority)
GUARDLENS_LLM_API_KEY=sk-your-key
GUARDLENS_LLM_BASE_URL=https://api.openai.com/v1
GUARDLENS_LLM_MODEL=gpt-4o-mini

# Conventional fallback names (used if the GUARDLENS_LLM_* pair is incomplete)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional local paths
# GUARDLENS_DB=data/derived/guardlens.duckdb
# GUARDLENS_CORPUS=data/derived/corpus/corpus.jsonl
# GUARDLENS_API_BASE=http://127.0.0.1:8000
